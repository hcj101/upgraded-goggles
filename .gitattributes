# Normalise to LF in the repo. Without this, a Windows checkout turns the
# shell scripts into CRLF and they fail inside the Linux containers with
# "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.bicep     text eol=lf
*.txt       text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf

*.png binary
*.jpg binary
*.so  binary
