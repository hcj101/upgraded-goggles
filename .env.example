# Copy to .env and chmod 600. Never commit .env.

# ---- Database ----------------------------------------------------------
# Pipeline role: read/write on run-scoped schemas.
DATABASE_URL_APP=postgresql://app:app@postgres:5432/appdb
# API role: SELECT on initiate/analysis/postprocess, INSERT on jobs.queue.
# It physically cannot write run-scoped tables.
DATABASE_URL_API=postgresql://api_ro:api_ro@postgres:5432/appdb

# ---- Interface -> API --------------------------------------------------
API_BASE_URL=http://api:8000
API_TIMEOUT_MS=10000
PORT=3000

# ---- Azure -------------------------------------------------------------
# Separate tenant/subscription from Safinea. No resource, identity or network
# is shared with the UNICEF deployment.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
RESOURCE_GROUP=rg-sim-dev
AZURE_LOCATION=swedencentral
ACR_NAME=acrsimdev

# Local dev only. In Azure containers use managed identity; in CI, GitHub OIDC.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

AZURE_STORAGE_ACCOUNT=stsimdev
AZURE_STORAGE_CONTAINER_ARTEFACTS=artefacts
AZURE_STORAGE_CONTAINER_USER_UPLOADS=user-uploads
